    "db:verify": "node scripts/verify-db.mjs",
    "db:setup": "node scripts/setup-database.mjs",
    "db:setup:test": "node scripts/test/db-setup.test.mjs",
    "test:prisma": "node scripts/test/prisma-client.test.mjs",
    "test:normalise": "node scripts/test/db-normalise.test.mjs",
    "verify:web": "node scripts/verify-web.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/blob": "^1.1.0",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "jsqr": "^1.4.0",
    "next": "16.3.5",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0"
