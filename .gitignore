# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-verify/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# environment / secrets — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# local secret overrides kept outside the git flow
*.local.env
secrets.json

# supabase CLI local state (local stack config + secrets)
/supabase/.temp/
/supabase/.branches/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
# The generated client is build output: `npm run db:generate` (part of build and
# typecheck) writes it from prisma/schema.prisma. It is ~1 MB of TypeScript that
# nobody edits by hand.
/src/generated/
