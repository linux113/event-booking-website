// ---------------------------------------------------------------------------
// Prisma schema — the client's view of the database.
//
// The schema itself is NOT managed here. It lives in `supabase/migrations/*.sql`
// and is applied by `npm run db:setup` (or the one-shot paste). Prisma is the
// typed client the app queries through, and the CLI is used for `generate` only:
// there are no `prisma migrate` commands in this project, deliberately, because
// the SQL carries things Prisma Migrate cannot express — 51 functions, triggers,
// RLS policies and generated columns.
//
// Field names follow the brief; `@map`/`@@map` hold the real column names where
// the database already had its own. So `Event.bannerUrl` reads the existing
// `hero_image_url` column, `PassCategory.price` reads `price_inr`, and
// `Booking.customerMobile` reads `customer_mobile`. Renaming in code without a
// migration that rewrites data.
//
// Connection: Prisma 7 keeps URLs out of this file. The CLI reads
// `prisma.config.ts`; the app passes a driver adapter to PrismaClient (see
// src/lib/db/client.ts).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// --- the festival -----------------------------------------------------------

model Event {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String    @unique
  name             String
  nameHindi        String?   @map("name_hindi")
  tagline          String?
  description      String?
  descriptionHindi String?   @map("description_hindi")
  venueName        String    @map("venue_name")
  venueHindi       String?   @map("venue_hindi")
  venueAddress     String?   @map("venue_address")
  city             String
  state            String?
  mapsUrl          String?   @map("maps_url")
  /// The hero/banner image. Named for what the brief calls it; the column keeps
  /// its original name so nothing has to be copied or renamed in the database.
  bannerUrl        String?   @map("hero_image_url")
  logoUrl          String?   @map("logo_url")
  contactPhone     String?   @map("contact_phone")
  /// The organiser's address. Distinct from the customer's, which does not exist
  /// any more.
  contactEmail     String?   @map("contact_email")
  whatsappNumber   String?   @map("whatsapp_number")
  currency         String    @default("INR")
  status           String    @default("draft")
  startDate        DateTime? @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  supportHours     String[]  @default([]) @map("support_hours")
  instagramUrl     String?   @map("instagram_url")
  facebookUrl      String?   @map("facebook_url")
  youtubeUrl       String?   @map("youtube_url")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  dates          EventDate[]
  passCategories PassCategory[]
  highlights     EventHighlight[]
  features       EventFeature[]
  gallery        GalleryItem[]
  // No `bookings` relation: a booking points at a night (EventDate), and the night
  // points at the event. There is no direct foreign key from bookings to events.

  @@map("events")
}

model EventDate {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  eventDate    DateTime  @map("event_date") @db.Date
  startTime    DateTime? @map("start_time") @db.Time(6)
  endTime      DateTime? @map("end_time") @db.Time(6)
  /// Seats the organiser reserved for the night.
  capacity     Int       @default(1000)
  /// Seats held back from sale (complimentary, blocked, reserved). Never negative,
  /// never more than `capacity` — a trigger enforces both.
  capacityHeld Int       @default(0) @map("capacity_held")
  /// Generated by the database: greatest(capacity - capacity_held, 0). Read-only.
  /// "On sale" is not the same as "still free": seats already sold are counted by
  /// get_event_night_availability(), which subtracts paid bookings. Use that for
  /// anything the customer sees.
  availableCapacity Int  @default(dbgenerated("greatest((capacity - capacity_held), 0)")) @map("available_capacity")
  status       String    @default("scheduled")
  bookingOpen  Boolean   @default(true) @map("booking_open")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookings Booking[]
  checkIns CheckIn[]

  @@unique([eventId, eventDate], map: "event_dates_unique_night")
  @@map("event_dates")
}

model PassCategory {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String  @map("event_id") @db.Uuid
  code           String
  name           String
  nameHindi      String? @map("name_hindi")
  composition    String
  description    String?
  imageUrl       String? @map("image_url")
  /// Rupees, not paise. The database recomputes every amount from this column;
  /// the browser never sends a price.
  price          Int     @map("price_inr")
  /// How many people one pass admits.
  peoplePerPass  Int     @map("number_of_people")
  maxPerBooking  Int     @default(10) @map("max_per_booking")
  minAge         Int     @default(0) @map("min_age")
  isActive       Boolean @default(true) @map("is_active")
  /// Generated by the database: 'active' | 'inactive', derived from isActive.
  /// Read-only; use isActive to write.
  status         String  @default(dbgenerated("case when is_active then 'active' else 'inactive' end"))
  sortOrder      Int     @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([eventId, code], map: "pass_categories_unique_code")
  @@map("pass_categories")
}

model EventHighlight {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  title       String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_highlights")
}

model EventFeature {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  code        String
  label       String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, code], map: "event_features_code_unique")
  @@map("event_features")
}

model GalleryItem {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String?   @map("event_id") @db.Uuid
  album         String?
  title         String?
  description   String?
  mediaType     String    @default("image") @map("media_type")
  /// Vercel Blob pathname. Supabase Storage is gone; this holds the Blob key.
  storagePath   String?   @map("storage_path")
  url           String?
  thumbnailUrl  String?   @map("thumbnail_url")
  thumbnailPath String?   @map("thumbnail_path")
  altText       String    @map("alt_text")
  capturedOn    DateTime? @map("captured_on") @db.Date
  status        String    @default("draft")
  sortOrder     Int       @default(0) @map("sort_order")
  width         Int?
  height        Int?
  byteSize      Int?      @map("byte_size")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("gallery")
}

// --- bookings, payments, passes, the gate -----------------------------------

model Booking {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The human-facing reference, e.g. DND202600001. Generated by the database.
  bookingId         String   @unique @map("booking_id") @default(dbgenerated("generate_booking_id()"))
  /// Random token behind /booking/[token] — never guessable from the reference.
  publicToken       String   @unique @default(dbgenerated("gen_random_uuid()")) @map("public_token") @db.Uuid
  customerName      String   @map("customer_name")
  /// The only way to reach the customer. No email is collected anywhere.
  customerMobile    String   @map("customer_mobile")
  eventDateId       String   @map("event_date_id") @db.Uuid
  passCategoryId    String   @map("pass_category_id") @db.Uuid
  quantity          Int
  numberOfPeople    Int      @map("number_of_people")
  subtotal          Int
  totalAmount       Int      @map("total_amount")
  /// pending | confirmed | cancelled | expired | refunded
  bookingStatus     String   @default("pending") @map("booking_status")
  /// unpaid | created | paid | failed | refunded
  paymentStatus     String   @default("unpaid") @map("payment_status")
  razorpayOrderId   String?  @unique @map("razorpay_order_id")
  razorpayPaymentId String?  @unique @map("razorpay_payment_id")
  notes             String?
  idempotencyKey    String?  @map("idempotency_key")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  eventDate    EventDate     @relation(fields: [eventDateId], references: [id])
  passCategory PassCategory  @relation(fields: [passCategoryId], references: [id])
  passes       DigitalPass[]
  checkIns     CheckIn[]

  @@map("bookings")
}

model DigitalPass {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String    @map("booking_id") @db.Uuid
  /// The display id printed on the pass, e.g. PS-000001.
  passId      String    @unique @map("pass_id") @default(dbgenerated("generate_pass_id()"))
  /// 64 hex characters. This is everything the QR code contains — no name, no
  /// mobile, no booking reference.
  qrToken     String    @unique @map("qr_token") @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)"))
  qrCodeUrl   String?   @map("qr_code_url")
  validDate   DateTime  @map("valid_date") @db.Date
  /// active | used | cancelled | expired
  status      String    @default("active")
  checkedIn   Boolean   @default(false) @map("checked_in")
  checkedInAt DateTime? @map("checked_in_at") @db.Timestamptz(6)
  passNumber  Int       @map("pass_number")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  checkIn CheckIn?

  @@map("digital_passes")
}

model CheckIn {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique: this is what makes a double check-in impossible, from any device.
  digitalPassId String   @unique @map("digital_pass_id") @db.Uuid
  eventDateId   String   @map("event_date_id") @db.Uuid
  bookingId     String   @map("booking_id") @db.Uuid
  gate          String?
  notes         String?
  checkedInAt   DateTime @default(now()) @map("checked_in_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pass      DigitalPass @relation(fields: [digitalPassId], references: [id], onDelete: Cascade)
  eventDate EventDate   @relation(fields: [eventDateId], references: [id])
  booking   Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("check_ins")
}

/// Raw record of every Razorpay delivery, before and after processing. The uniqu
/// `event_id` is Razorpay's event id: a replayed webhook hits the constraint and
/// changes nothing.
model PaymentEvent {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId           String    @unique @map("event_id")
  eventType         String    @map("event_type")
  razorpayOrderId   String?   @map("razorpay_order_id")
  razorpayPaymentId String?   @map("razorpay_payment_id")
  /// Paise, exactly as Razorpay reports it.
  amountPaise       Int?      @map("amount_paise")
  outcome           String    @default("received")
  receivedAt        DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt       DateTime? @map("processed_at") @db.Timestamptz(6)

  @@map("payment_events")
}
