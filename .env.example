# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
# Never commit `.env.local` (it is git-ignored). In production, set the same
# variables in Vercel → Project → Settings → Environment Variables.
#
# These are empty on purpose: every value below is created by you in the
# Supabase / Razorpay dashboards. None of them are generated by the code, and no
# real credential is ever committed to this repository.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Public base URL of the deployment. Used for canonical/OG URLs and later for
# payment callbacks. Leave unset locally (http://localhost:3000 is the default).
# On Vercel, VERCEL_URL is picked up automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (database + auth) ---------------------------------------------
# Supabase dashboard → Project Settings → API.
#
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are safe in the
# browser: the anon key is public by design and Row Level Security decides what
# it can actually read. Access is never controlled by hiding these.
#
# Setup checklist:
#   1. Create a project at https://supabase.com (free tier is enough).
#   2. Apply the schema:  supabase/README.md → "Applying the schema".
#   3. Paste the Project URL and the `anon` public key below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security, so it must never reach the browser:
# it is read only by src/lib/supabase/admin.ts, which imports "server-only" and
# will fail the build if it is ever pulled into client code. Rotate it
# immediately from the dashboard if it leaks.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (payments) ----------------------------------------------------
# Dashboard → Settings → API Keys.
# Key ID is public (it opens Checkout in the browser).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Key secret is server-only: used to create orders and to verify the checkout
# signature. Never expose it to the browser.
RAZORPAY_KEY_SECRET=
# Secret used to verify Razorpay webhook signatures (Dashboard → Webhooks).
RAZORPAY_WEBHOOK_SECRET=
