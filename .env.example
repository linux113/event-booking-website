# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
# Never commit `.env.local` (it is git-ignored). In production, set the same
# variables in Vercel → Project → Settings → Environment Variables.
#
# These are empty on purpose: every value below is created by you in the
# Neon / Razorpay / Vercel dashboards. None of them are generated by the code,
# and no real credential is ever committed to this repository.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Public base URL of the deployment. Used for canonical/OG URLs and — important —
# as the base of the link inside every pass QR code, so a phone scanning a printed
# pass reaches this exact host. Set it before printing passes. Leave unset locally
# (http://localhost:3000 is the default); on Vercel, VERCEL_URL is picked up
# automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Neon (PostgreSQL via Prisma) -------------------------------------------
# Neon dashboard → Connect → use the **pooled** connection string (host contains
# `-pooler`) for the app. Remove `channel_binding=require` if present — Node
# drivers do not speak that libpq option and the connection will fail.
# Schema/migrations (npm run db:setup) should use the **direct** (non-pooler) string.
#
# Server-only. Never prefix with NEXT_PUBLIC_. Never commit a filled-in value.
DATABASE_URL=

# --- Razorpay (payments) ----------------------------------------------------
# Dashboard → Settings → API Keys. Start with TEST keys (`rzp_test_…`): the server
# refuses to create an order with a live key unless RAZORPAY_ALLOW_LIVE=true is set
# on purpose, so live payments cannot be switched on by accident.
#
# Setup checklist:
#   1. Create the keys (test mode first) in the Razorpay dashboard.
#   2. Dashboard → Webhooks → add https://<your-domain>/api/payment/webhook and
#      subscribe to payment.captured, payment.failed and refund.processed
#      (order.paid is optional), then paste the webhook secret below.
#   3. Nothing else: the amount is always read from the booking row.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Server-only: creates orders and verifies the Checkout signature,
# HMAC_SHA256("<order_id>|<payment_id>", RAZORPAY_KEY_SECRET). Never expose it.
RAZORPAY_KEY_SECRET=

# Server-only: verifies the x-razorpay-signature header on every webhook delivery,
# HMAC_SHA256(raw_body, RAZORPAY_WEBHOOK_SECRET). Never expose it.
RAZORPAY_WEBHOOK_SECRET=

# Optional, and deliberately empty. Live keys (`rzp_live_…`) are refused while this
# is anything other than "true"; the site then shows the organiser-handled payment
# copy instead of a checkout. Set it only when you really are going live.
RAZORPAY_ALLOW_LIVE=

# --- Admin authentication ----------------------------------------------------
# One administrator. No roles, no staff table — a successful login grants full
# access to /admin and /api/admin/*.
#
# Admin email shown on /admin/login (compared case-insensitively).
ADMIN_EMAIL=

# Legacy: ADMIN_USERNAME is still accepted if ADMIN_EMAIL is unset.
# Password hash — never the plain password. Generate one locally with Node:
#   (In `.env.local` files Next expands `$VAR`, so escape every `$` in the pasted
#   hash as `\$` — e.g. scrypt\$ab12…\$cd34… — or the value is silently truncated.)
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');const h=c.scryptSync(process.argv[1],Buffer.from(s,'hex'),64).toString('hex');console.log('scrypt$'+s+'$'+h)" 'your-strong-password'
# Stored form: scrypt$<salt-hex>$<hash-hex>. Server-only.
ADMIN_PASSWORD_HASH=

# Secret used to sign the HTTP-only admin session cookie (HMAC-SHA256).
# Use at least 32 random bytes, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Gallery storage (Vercel Blob) ------------------------------------------
# Vercel dashboard → Storage → Blob → create a store, then copy the token.
# Required for admin photo upload/publish; the public gallery reads the stored
# URLs. Server-only.
BLOB_READ_WRITE_TOKEN=
