# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
# Never commit `.env.local` (it is git-ignored). In production, set the same
# variables in Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Public base URL of the deployment. Used for canonical/OG URLs and later for
# payment callbacks. Leave unset locally (http://localhost:3000 is the default).
# On Vercel, VERCEL_URL is picked up automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (database + auth) ---------------------------------------------
# Dashboard → Project Settings → API. Both values are safe for the browser:
# access is enforced by Row Level Security policies, not by secrecy.
# NOT USED YET — wired up in a later step.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Bypasses Row Level Security and must never reach the client
# bundle or be prefixed with NEXT_PUBLIC_. Only for trusted server code
# (admin actions, webhooks). Rotate it immediately if it ever leaks.
# NOT USED YET.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (payments) ----------------------------------------------------
# Dashboard → Settings → API Keys.
# Key ID is public (used to open Checkout in the browser).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Key secret is server-only: it is used to create orders and to verify the
# checkout signature. Never expose it to the browser.
RAZORPAY_KEY_SECRET=
# Secret used to verify Razorpay webhook signatures (Dashboard → Webhooks).
RAZORPAY_WEBHOOK_SECRET=
# NOT USED YET — payments are implemented in a later step.
