# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
# Never commit `.env.local` (it is git-ignored). In production, set the same
# variables in Vercel → Project → Settings → Environment Variables.
#
# These are empty on purpose: every value below is created by you in the
# Supabase / Razorpay dashboards. None of them are generated by the code, and no
# real credential is ever committed to this repository.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Public base URL of the deployment. Used for canonical/OG URLs and — important —
# as the base of the link inside every pass QR code, so a phone scanning a printed
# pass reaches this exact host. Set it before printing passes. Leave unset locally
# (http://localhost:3000 is the default); on Vercel, VERCEL_URL is picked up
# automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (database + auth) ---------------------------------------------
# Supabase dashboard → Project Settings → API.
#
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are safe in the
# browser: the anon key is public by design and Row Level Security decides what
# it can actually read. Access is never controlled by hiding these.
#
# Setup checklist:
#   1. Create a project at https://supabase.com (free tier is enough).
#   2. Apply the schema:  supabase/README.md → "Applying the schema".
#   3. Paste the Project URL and the `anon` public key below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security, so it must never reach the browser:
# it is read only by src/lib/supabase/admin.ts, which imports "server-only" and
# will fail the build if it is ever pulled into client code. Rotate it
# immediately from the dashboard if it leaks.
#
# Required for booking creation: POST /api/bookings calls the
# create_pending_booking() function with this key, and returns 503 without it.
# Reading event and pass data only needs the anon key above.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (payments) ----------------------------------------------------
# Dashboard → Settings → API Keys. Start with TEST keys (`rzp_test_…`): the server
# refuses to create an order with a live key unless RAZORPAY_ALLOW_LIVE=true is set
# on purpose, so live payments cannot be switched on by accident.
#
# Setup checklist:
#   1. Create the keys (test mode first) in the Razorpay dashboard.
#   2. Dashboard → Webhooks → add https://<your-domain>/api/payment/webhook and
#      subscribe to payment.captured, payment.failed and refund.processed
#      (order.paid is optional), then paste the webhook secret below.
#   3. Nothing else: the amount is always read from the booking row.
#
# `NEXT_PUBLIC_*` values are inlined when the app is built, so changing the key id
# means a new deployment. The two secrets below are read at runtime and are never
# inlined — see src/lib/payments/razorpay.ts, which imports "server-only".
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Server-only: creates orders and verifies the Checkout signature,
# HMAC_SHA256("<order_id>|<payment_id>", RAZORPAY_KEY_SECRET). Never expose it.
RAZORPAY_KEY_SECRET=

# Server-only: verifies the x-razorpay-signature header on every webhook delivery,
# HMAC_SHA256(raw_body, RAZORPAY_WEBHOOK_SECRET). Never expose it.
RAZORPAY_WEBHOOK_SECRET=

# Optional, and deliberately empty. Live keys (`rzp_live_…`) are refused while this
# is anything other than "true"; the site then shows the organiser-handled payment
# copy instead of a checkout. Set it only when you really are going live.
RAZORPAY_ALLOW_LIVE=
